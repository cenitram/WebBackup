{
  "routes": [
    {
      "route": "/api/register-subscriber",
      "methods": [ "POST", "OPTIONS" ],
      "allowedRoles": [ "anonymous" ]
    },
    {
      "route": "/api/*",
      "allowedRoles": [ "authenticated" ]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [ "/api/*" ]
  }
}