                                                                                    <td>@doc.Name</td>
                                                                                    <td>@doc.Description</td>
                                                                                    <td><a class="doc-link" href="@url" target="_blank" rel="noopener noreferrer">@doc.FileName</a></td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                    <p style="font-size:12px;line-height:18px;color:#666666;font-family:'source sans pro','helvetica neue',helvetica,arial,sans-serif;margin:12px 0 0 0;">Toto je automaticky generovaná zpráva.</p>
